{
  "manifest_version": 3,
  "name": "Page AI Assistant",
  "version": "1.0",
  "description": "Extracts active tab content and answers questions using AI.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "min_width": 320,
    "max_width": 480,
    "min_height": 500,
    "max_height": 500
  }
}